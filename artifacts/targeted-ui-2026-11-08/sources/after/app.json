{
  "expo": {
    "name": "NFCFit",
    "slug": "nfcfit",
    "owner": "sdemirhan",
    "version": "1.0.22",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nfcfit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.serkandemirhan.nfcfit",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:nfc-fit.vercel.app"
      ],
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": [
          "TAG"
        ]
      },
      "infoPlist": {
        "NFCReaderUsageDescription": "This app uses NFC to scan fitness exercise tags and log workouts.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 23,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "nfc-fit.vercel.app",
              "pathPrefix": "/tag/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "package": "com.serkandemirhan.nfcfit",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.NFC"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-nfc-links.cjs",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "01d37fa5-bdf4-4131-8b3b-e9bf0cfd1b6c"
      }
    }
  }
}
