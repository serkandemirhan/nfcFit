{
  "name": "nfc-task-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run trainer:styles && vite build",
    "preview": "vite preview",
    "test:trainer-planning": "node --test tests/trainer-planning.test.cjs",
    "test:trainer-browser": "node tests/trainer-planning.browser.cjs",
    "test:trainer-precision": "node tests/trainer-precision.browser.cjs",
    "test:trainer-save-state": "node --test tests/trainer-save-state.test.cjs",
    "test:trainer-quality": "node tests/trainer-quality.browser.cjs",
    "test:trainer-panel": "node tests/trainer-panel.browser.cjs",
    "test:trainer-panel-ui": "node tests/trainer-panel.admin.cjs",
    "trainer:styles": "tailwindcss -c trainer.tailwind.config.cjs -i trainer-tailwind.input.css -o trainer-utilities.css --minify",
    "test:trainer-density": "node tests/trainer-density.browser.cjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/supabase-js": "^2.46.2",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.70.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.65.0",
    "tailwindcss": "3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
